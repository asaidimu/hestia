{
  "schema": {
    "glob": "core/system/**/*.schema.json",
    "lockfile": "schemas.lock.json",
    "migrations_dir": "core/internal/migrations"
  },
  "gogen": {
    "name_rules": [
      { "pattern": "^_(.+)_$", "prefix": "System" }
    ],
    "scoped": false
  },
  "metadata": {
    "schema_path": "metadata.schema.json",
    "out_dir": ""
  }
}
